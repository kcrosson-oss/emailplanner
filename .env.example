# Copy to .env.local for local overrides. All optional locally.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # unset = built-in local database
# SESSION_SECRET=change-me-to-a-long-random-string
# TEAM_PASSCODE=resq-local
# AUTH_MODE=passcode            # or: google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_DOMAIN=getresq.com
# APP_URL=https://emails.getresq.com
